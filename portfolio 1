<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>D. Rithika Rani — UI/UX Designer</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,700;1,9..40,300;1,9..40,400&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet">
<style>
  :root {
    --lime: #C8F135;
    --lime-dark: #a8d020;
    --black: #0a0a0a;
    --white: #fafafa;
    --gray: #888;
    --gray-light: #f0f0f0;
    --gray-mid: #e0e0e0;
    --beige: #D4A96A;
    --blue: #2563EB;
    --violet: #5B21B6;
    --radius: 20px;
    --transition: 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--white);
    color: var(--black);
    overflow-x: hidden;
    cursor: none;
  }

  /* Custom cursor */
  .cursor {
    width: 12px; height: 12px;
    background: var(--black);
    border-radius: 50%;
    position: fixed;
    pointer-events: none;
    z-index: 9999;
    transform: translate(-50%, -50%);
    transition: transform 0.1s, width 0.3s, height 0.3s, background 0.3s;
  }
  .cursor-follower {
    width: 36px; height: 36px;
    border: 1.5px solid var(--black);
    border-radius: 50%;
    position: fixed;
    pointer-events: none;
    z-index: 9998;
    transform: translate(-50%, -50%);
    transition: transform 0.15s ease, width 0.3s, height 0.3s;
    opacity: 0.5;
  }
  body:has(a:hover) .cursor, body:has(button:hover) .cursor { background: var(--lime); transform: translate(-50%,-50%) scale(1.5); }
  body:has(a:hover) .cursor-follower, body:has(button:hover) .cursor-follower { width: 60px; height: 60px; border-color: var(--lime); }

  /* Page system */
  .page { display: none; min-height: 100vh; }
  .page.active { display: block; animation: pageIn 0.6s var(--transition) both; }
  @keyframes pageIn {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* NAV */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 20px 60px;
    background: rgba(250,250,250,0.9);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--gray-mid);
  }
  .nav-logo {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 22px; letter-spacing: 2px;
    cursor: pointer; text-decoration: none; color: var(--black);
  }
  .nav-links { display: flex; gap: 36px; list-style: none; }
  .nav-links a {
    font-size: 14px; font-weight: 500; text-decoration: none;
    color: var(--black); letter-spacing: 0.5px;
    position: relative; padding-bottom: 2px;
  }
  .nav-links a::after {
    content: ''; position: absolute; bottom: 0; left: 0;
    width: 0; height: 2px; background: var(--lime);
    transition: width 0.3s ease;
  }
  .nav-links a:hover::after { width: 100%; }
  .nav-cta {
    background: var(--black); color: var(--white);
    padding: 10px 24px; border-radius: 100px;
    font-size: 13px; font-weight: 500; text-decoration: none;
    transition: background 0.3s, transform 0.2s;
  }
  .nav-cta:hover { background: var(--lime); color: var(--black); transform: scale(1.05); }

  /* Hamburger */
  .nav-hamburger { display: none; flex-direction: column; gap: 5px; cursor: pointer; z-index: 200; }
  .nav-hamburger span { width: 24px; height: 2px; background: var(--black); transition: all 0.3s; }

  /* Mobile nav overlay */
  .mobile-nav {
    display: none; position: fixed; inset: 0; background: var(--white);
    z-index: 150; flex-direction: column; align-items: center; justify-content: center; gap: 40px;
  }
  .mobile-nav.open { display: flex; }
  .mobile-nav a { font-family: 'Bebas Neue', sans-serif; font-size: 48px; text-decoration: none; color: var(--black); letter-spacing: 2px; }
  .mobile-nav a:hover { color: var(--lime); }

  /* ============ HOME PAGE ============ */
  .hero {
    padding: 160px 60px 100px;
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: 'PORTFOLIO';
    position: absolute;
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(100px, 18vw, 280px);
    color: var(--gray-light);
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    white-space: nowrap;
    z-index: 0;
    pointer-events: none;
    letter-spacing: -5px;
  }
  .hero-content { position: relative; z-index: 1; }
  .hero-year {
    display: inline-block;
    background: var(--lime);
    color: var(--black);
    font-family: 'Bebas Neue', sans-serif;
    font-size: 15px; letter-spacing: 3px;
    padding: 6px 16px; border-radius: 100px;
    margin-bottom: 28px;
  }
  .hero-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(64px, 8vw, 120px);
    line-height: 0.9;
    letter-spacing: -2px;
    margin-bottom: 24px;
  }
  .hero-title span { color: var(--lime); }
  .hero-sub {
    font-size: 13px; font-weight: 500;
    letter-spacing: 3px; text-transform: uppercase;
    color: var(--gray); margin-bottom: 20px;
  }
  .hero-tagline {
    font-family: 'DM Serif Display', serif;
    font-style: italic;
    font-size: clamp(18px, 2.5vw, 26px);
    line-height: 1.4;
    color: var(--black);
    margin-bottom: 20px;
  }
  .hero-intro {
    font-size: 15px; line-height: 1.8; color: #444;
    max-width: 480px; margin-bottom: 40px;
  }
  .hero-btns { display: flex; gap: 16px; flex-wrap: wrap; }
  .btn-primary {
    background: var(--black); color: var(--white);
    padding: 14px 32px; border-radius: 100px;
    font-size: 14px; font-weight: 600; text-decoration: none;
    cursor: pointer; border: none;
    transition: all 0.3s; letter-spacing: 0.5px;
    display: inline-block;
  }
  .btn-primary:hover { background: var(--lime); color: var(--black); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(200,241,53,0.4); }
  .btn-secondary {
    background: transparent; color: var(--black);
    padding: 14px 32px; border-radius: 100px;
    font-size: 14px; font-weight: 600; text-decoration: none;
    cursor: pointer; border: 2px solid var(--black);
    transition: all 0.3s; letter-spacing: 0.5px;
    display: inline-block;
  }
  .btn-secondary:hover { background: var(--black); color: var(--white); transform: translateY(-2px); }

  .hero-visual {
    position: relative; z-index: 1;
    display: flex; align-items: center; justify-content: center;
  }
  .hero-mockup-wrap {
    width: 100%; max-width: 460px;
    aspect-ratio: 9/16;
    max-height: 520px;
    background: linear-gradient(135deg, var(--gray-light) 0%, #e8e8e8 100%);
    border-radius: 28px;
    display: flex; align-items: center; justify-content: center;
    position: relative; overflow: hidden;
    box-shadow: 0 32px 80px rgba(0,0,0,0.12);
  }
  .hero-mockup-wrap::before {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(circle at 30% 20%, var(--lime) 0%, transparent 50%);
    opacity: 0.3;
  }
  .hero-mockup-inner {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 80px; color: rgba(0,0,0,0.08);
    letter-spacing: -4px; text-align: center;
    z-index: 1;
  }
  .hero-badge {
    position: absolute; bottom: -16px; right: -16px;
    width: 100px; height: 100px;
    background: var(--lime);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    flex-direction: column;
    box-shadow: 0 8px 32px rgba(200,241,53,0.4);
  }
  .hero-badge span:first-child { font-family: 'Bebas Neue', sans-serif; font-size: 28px; line-height: 1; }
  .hero-badge span:last-child { font-size: 9px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; }

  .scroll-hint {
    position: absolute; bottom: 40px; left: 60px;
    display: flex; align-items: center; gap: 12px;
    font-size: 12px; letter-spacing: 2px; text-transform: uppercase;
    color: var(--gray); z-index: 1;
  }
  .scroll-line { width: 40px; height: 1px; background: var(--gray); }

  /* ABOUT SECTION */
  .section { padding: 100px 60px; }
  .section-label {
    font-size: 11px; letter-spacing: 4px; text-transform: uppercase;
    color: var(--lime); font-weight: 600; margin-bottom: 20px;
    display: flex; align-items: center; gap: 12px;
  }
  .section-label::before { content: ''; width: 30px; height: 2px; background: var(--lime); }

  .about-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 80px; align-items: start;
  }
  .about-heading {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(60px, 7vw, 100px);
    line-height: 0.9; letter-spacing: -2px;
    margin-bottom: 32px;
  }
  .about-heading em { color: var(--lime); font-style: normal; }
  .about-text { font-size: 16px; line-height: 1.9; color: #333; margin-bottom: 20px; }
  .about-quote {
    font-family: 'DM Serif Display', serif;
    font-style: italic; font-size: 20px; line-height: 1.6;
    color: var(--black); padding-left: 24px;
    border-left: 3px solid var(--lime);
    margin-top: 32px;
  }
  .about-right { padding-top: 20px; }
  .stat-row { display: flex; gap: 40px; margin-bottom: 48px; }
  .stat-box { flex: 1; }
  .stat-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 56px; line-height: 1; letter-spacing: -2px;
    margin-bottom: 6px;
  }
  .stat-num span { color: var(--lime); }
  .stat-label { font-size: 12px; color: var(--gray); letter-spacing: 1px; text-transform: uppercase; }

  /* SKILLS */
  .skills-section { padding: 80px 60px; background: var(--black); }
  .skills-section .section-label { color: var(--lime); }
  .skills-section .section-label::before { background: var(--lime); }
  .skills-heading {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(48px, 6vw, 80px);
    letter-spacing: -2px; color: var(--white);
    margin-bottom: 48px; line-height: 1;
  }
  .skills-heading span { color: var(--lime); }
  .skills-tags { display: flex; flex-wrap: wrap; gap: 12px; }
  .tag {
    padding: 10px 20px; border-radius: 100px;
    border: 1px solid #333; color: var(--white);
    font-size: 13px; font-weight: 500;
    transition: all 0.3s; cursor: default;
    letter-spacing: 0.3px;
  }
  .tag:hover { background: var(--lime); color: var(--black); border-color: var(--lime); transform: translateY(-2px); }
  .tag.tool { border-color: #444; color: #aaa; }
  .tag.tool:hover { background: var(--lime); color: var(--black); border-color: var(--lime); }

  /* WORK SECTION */
  .work-section { padding: 100px 60px; }
  .work-header {
    display: flex; justify-content: space-between;
    align-items: flex-end; margin-bottom: 60px;
  }
  .work-title-wrap {}
  .work-heading {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(60px, 7vw, 100px);
    line-height: 0.9; letter-spacing: -2px;
  }
  .work-count { font-family: 'Bebas Neue', sans-serif; font-size: 120px; color: var(--gray-light); line-height: 0.8; }

  .projects-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }

  .project-card {
    border-radius: var(--radius); overflow: hidden;
    background: var(--white);
    box-shadow: 0 4px 24px rgba(0,0,0,0.06);
    border: 1px solid var(--gray-mid);
    transition: all 0.4s ease;
    cursor: pointer; position: relative;
  }
  .project-card:hover { transform: translateY(-8px); box-shadow: 0 24px 64px rgba(0,0,0,0.12); }

  .card-visual {
    height: 280px; position: relative;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
  }
  .card-visual-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 180px; color: rgba(255,255,255,0.2);
    position: absolute; bottom: -20px; right: -10px;
    line-height: 1; z-index: 0;
    letter-spacing: -8px;
  }
  .card-mockup-placeholder {
    width: 160px; height: 200px;
    background: rgba(255,255,255,0.15);
    border-radius: 16px;
    display: flex; align-items: center; justify-content: center;
    font-size: 12px; color: rgba(255,255,255,0.5);
    letter-spacing: 1px; text-transform: uppercase;
    border: 1px dashed rgba(255,255,255,0.2);
    z-index: 1; position: relative;
    backdrop-filter: blur(4px);
  }
  .card-mockup-placeholder::before {
    content: '⊞'; font-size: 32px; display: block;
    margin-bottom: 8px; text-align: center;
    color: rgba(255,255,255,0.3);
  }

  .card-body { padding: 28px 32px 32px; }
  .card-meta { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
  .card-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 48px; line-height: 1;
    color: var(--gray-light); letter-spacing: -2px;
  }
  .card-type {
    font-size: 10px; letter-spacing: 2px; text-transform: uppercase;
    color: var(--gray); padding: 4px 12px;
    border: 1px solid var(--gray-mid); border-radius: 100px;
  }
  .card-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 36px; letter-spacing: -1px;
    margin-bottom: 6px; line-height: 1;
  }
  .card-subtitle { font-size: 13px; color: var(--gray); margin-bottom: 14px; font-weight: 500; }
  .card-desc { font-size: 14px; line-height: 1.7; color: #555; margin-bottom: 24px; }
  .card-cta {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 13px; font-weight: 600; letter-spacing: 0.5px;
    text-decoration: none; color: var(--black);
    border-bottom: 2px solid var(--black);
    padding-bottom: 2px; cursor: pointer;
    background: none; border-top: none; border-left: none; border-right: none;
    transition: all 0.3s;
  }
  .card-cta:hover { color: var(--lime); border-color: var(--lime); gap: 14px; }
  .card-cta-arrow { font-size: 16px; transition: transform 0.3s; }
  .card-cta:hover .card-cta-arrow { transform: translateX(4px); }

  /* Project card colors */
  .proj-1 .card-visual { background: linear-gradient(135deg, #1a1a1a 0%, #2d4a00 100%); }
  .proj-1 .card-num, .proj-1 .card-cta { color: var(--lime); }
  .proj-1 .card-cta { border-color: var(--lime); }
  .proj-1 .card-title { color: var(--black); }

  .proj-2 .card-visual { background: linear-gradient(135deg, #2a1f0e 0%, #5c3d1e 100%); }
  .proj-2 .card-num { color: var(--beige); }
  .proj-2 .card-cta { color: var(--beige); border-color: var(--beige); }

  .proj-3 .card-visual { background: linear-gradient(135deg, #0a1628 0%, #1e3a6e 100%); }
  .proj-3 .card-num { color: #93B5F5; }
  .proj-3 .card-cta { color: var(--blue); border-color: var(--blue); }

  .proj-4 .card-visual { background: linear-gradient(135deg, #0d0a1e 0%, #2d1b6e 100%); }
  .proj-4 .card-num { color: #B49AF0; }
  .proj-4 .card-cta { color: var(--violet); border-color: var(--violet); }

  /* CONTACT / FOOTER */
  .contact-section { padding: 100px 60px; background: var(--black); }
  .contact-heading {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(48px, 6vw, 90px);
    color: var(--white); letter-spacing: -2px;
    line-height: 1; margin-bottom: 12px;
  }
  .contact-heading span { color: var(--lime); }
  .contact-sub { font-size: 16px; color: #888; margin-bottom: 60px; line-height: 1.7; max-width: 480px; }
  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; }
  .contact-links { display: flex; flex-direction: column; gap: 20px; }
  .contact-link {
    display: flex; align-items: center; gap: 16px;
    text-decoration: none; color: var(--white);
    font-size: 15px; font-weight: 500;
    padding: 16px 20px; border-radius: 12px;
    border: 1px solid #222;
    transition: all 0.3s;
  }
  .contact-link:hover { background: #111; border-color: var(--lime); transform: translateX(6px); }
  .contact-icon {
    width: 36px; height: 36px; background: #1a1a1a;
    border-radius: 8px; display: flex; align-items: center;
    justify-content: center; font-size: 16px; flex-shrink: 0;
  }
  .contact-right { display: flex; flex-direction: column; justify-content: center; }
  .contact-big {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(40px, 5vw, 72px);
    color: var(--white); letter-spacing: -2px;
    line-height: 1.1; margin-bottom: 24px;
  }
  .contact-big span { color: var(--lime); }
  .footer-bottom {
    margin-top: 80px; padding-top: 32px;
    border-top: 1px solid #1a1a1a;
    display: flex; justify-content: space-between;
    align-items: center;
    font-size: 12px; color: #555;
  }
  .footer-logo { font-family: 'Bebas Neue', sans-serif; font-size: 20px; color: var(--white); letter-spacing: 2px; }

  /* ============ CASE STUDY PAGES ============ */
  .case-back-btn {
    position: fixed; top: 24px; left: 60px; z-index: 200;
    display: flex; align-items: center; gap: 10px;
    background: var(--white); color: var(--black);
    padding: 10px 20px; border-radius: 100px;
    font-size: 13px; font-weight: 600;
    box-shadow: 0 4px 16px rgba(0,0,0,0.1);
    cursor: pointer; border: 1px solid var(--gray-mid);
    transition: all 0.3s; text-decoration: none;
  }
  .case-back-btn:hover { background: var(--black); color: var(--white); transform: translateX(-4px); }

  .case-hero {
    min-height: 70vh; display: flex; flex-direction: column;
    justify-content: flex-end; padding: 140px 60px 80px;
    position: relative; overflow: hidden;
  }
  .case-hero-num {
    position: absolute; top: 80px; right: 60px;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 200px; color: rgba(255,255,255,0.06);
    letter-spacing: -10px; line-height: 1;
  }
  .case-type {
    font-size: 11px; letter-spacing: 4px; text-transform: uppercase;
    color: rgba(255,255,255,0.5); margin-bottom: 20px;
    display: flex; align-items: center; gap: 12px;
  }
  .case-type::before { content: ''; width: 30px; height: 1px; background: currentColor; }
  .case-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(56px, 8vw, 120px);
    color: var(--white); letter-spacing: -3px;
    line-height: 0.9; margin-bottom: 24px;
  }
  .case-hero-q {
    font-family: 'DM Serif Display', serif;
    font-style: italic; font-size: clamp(18px, 2.5vw, 28px);
    color: rgba(255,255,255,0.7); max-width: 640px;
    line-height: 1.5; margin-bottom: 40px;
  }
  .case-meta-row { display: flex; gap: 40px; flex-wrap: wrap; }
  .case-meta-item { }
  .case-meta-label { font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: rgba(255,255,255,0.4); margin-bottom: 6px; }
  .case-meta-val { font-size: 14px; color: rgba(255,255,255,0.85); font-weight: 500; }

  .case-body { padding: 80px 60px; }
  .case-section { margin-bottom: 80px; }
  .case-section-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 40px; letter-spacing: -1px;
    margin-bottom: 24px; line-height: 1;
    display: flex; align-items: center; gap: 12px;
  }
  .case-section-title span { font-size: 14px; font-family: 'DM Sans', sans-serif; font-weight: 400; color: var(--gray); letter-spacing: 0; }
  .case-p { font-size: 16px; line-height: 1.9; color: #333; margin-bottom: 16px; }
  .case-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-bottom: 40px; }
  .case-grid-2 { grid-template-columns: 1fr 1fr; }
  .case-card {
    padding: 24px; border-radius: 16px;
    border: 1px solid var(--gray-mid);
    background: var(--white);
  }
  .case-card-icon { font-size: 28px; margin-bottom: 12px; }
  .case-card-title { font-weight: 700; font-size: 14px; margin-bottom: 8px; }
  .case-card-text { font-size: 13px; line-height: 1.6; color: #555; }
  .case-stat-row { display: flex; gap: 32px; flex-wrap: wrap; margin: 40px 0; }
  .case-stat {
    flex: 1; min-width: 160px;
    padding: 28px; border-radius: 16px;
    text-align: center;
  }
  .case-stat-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 56px; letter-spacing: -2px; line-height: 1;
    margin-bottom: 8px;
  }
  .case-stat-label { font-size: 13px; color: #555; }
  .case-mockup-full {
    width: 100%; border-radius: 20px; overflow: hidden;
    background: var(--gray-light); aspect-ratio: 16/9;
    display: flex; align-items: center; justify-content: center;
    font-size: 14px; color: var(--gray); letter-spacing: 2px;
    text-transform: uppercase; margin: 40px 0;
    flex-direction: column; gap: 8px;
    border: 2px dashed var(--gray-mid);
  }
